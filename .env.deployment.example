# OpenClaw Deployment Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# DEPLOYMENT PLATFORM
# =============================================================================

# Choose your deployment platform: fly, render, docker, all
PLATFORM=fly

# Deployment environment: staging, production
ENVIRONMENT=production

# =============================================================================
# FLY.IO CONFIGURATION
# =============================================================================

# Fly.io API token (get from: fly auth token)
FLY_API_TOKEN=

# Fly.io app name (default: openclaw for production, openclaw-staging for staging)
FLY_APP_NAME=openclaw

# Fly.io primary region (find closest: https://fly.io/docs/reference/regions/)
FLY_REGION=iad

# =============================================================================
# RENDER CONFIGURATION
# =============================================================================

# Render API key (get from: https://dashboard.render.com/account)
RENDER_API_KEY=

# Render service ID (find in service dashboard URL)
RENDER_SERVICE_ID=

# =============================================================================
# DOCKER REGISTRY
# =============================================================================

# Docker registry URL (default: GitHub Container Registry)
DOCKER_REGISTRY=ghcr.io

# Docker image name (format: owner/repo)
DOCKER_IMAGE_NAME=openclaw/openclaw

# Docker registry username
DOCKER_USERNAME=

# Docker registry password/token
DOCKER_PASSWORD=

# =============================================================================
# OPENCLAW GATEWAY CONFIGURATION
# =============================================================================

# Gateway authentication token (generate a secure random string)
OPENCLAW_GATEWAY_TOKEN=

# Gateway bind interface: loopback (127.0.0.1) or lan (0.0.0.0)
OPENCLAW_GATEWAY_BIND=lan

# Gateway port (default: 18789)
OPENCLAW_GATEWAY_PORT=18789

# Bridge port (default: 18790)
OPENCLAW_BRIDGE_PORT=18790

# =============================================================================
# AI PROVIDER CREDENTIALS (choose one or more)
# =============================================================================

# Claude AI Session (web provider)
CLAUDE_AI_SESSION_KEY=
CLAUDE_WEB_SESSION_KEY=
CLAUDE_WEB_COOKIE=

# Anthropic API
ANTHROPIC_API_KEY=

# OpenAI API
OPENAI_API_KEY=

# AWS Bedrock (if using)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# =============================================================================
# STORAGE CONFIGURATION
# =============================================================================

# State directory (for sessions, config, etc.)
OPENCLAW_STATE_DIR=/data/.openclaw

# Workspace directory (for user files)
OPENCLAW_WORKSPACE_DIR=/data/workspace

# Local config directory (for development)
OPENCLAW_CONFIG_DIR=${HOME}/.openclaw

# =============================================================================
# NODE.JS CONFIGURATION
# =============================================================================

# Node environment
NODE_ENV=production

# Node.js memory limit (in MB)
NODE_OPTIONS=--max-old-space-size=1536

# Prefer pnpm for builds (set to 1)
OPENCLAW_PREFER_PNPM=1

# =============================================================================
# MESSAGING CHANNELS (optional)
# =============================================================================

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# Discord Bot
DISCORD_BOT_TOKEN=

# Slack Bot
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Signal
SIGNAL_PHONE_NUMBER=

# =============================================================================
# DEPLOYMENT OPTIONS
# =============================================================================

# Skip tests during deployment (not recommended for production)
SKIP_TESTS=false

# Skip build during deployment (use existing dist/)
SKIP_BUILD=false

# Dry run deployment (don't actually deploy)
DRY_RUN=false

# Override version detection (optional)
OPENCLAW_VERSION=

# =============================================================================
# CI/CD CONFIGURATION (GitHub Actions)
# =============================================================================

# GitHub token for container registry
GITHUB_TOKEN=

# =============================================================================
# MONITORING & LOGGING (optional)
# =============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Enable request logging
ENABLE_REQUEST_LOGGING=false

# Sentry DSN (for error tracking)
SENTRY_DSN=

# =============================================================================
# SECURITY
# =============================================================================

# Setup password (for initial configuration)
SETUP_PASSWORD=

# Force HTTPS (set to 1 for production)
FORCE_HTTPS=1

# Allowed origins (comma-separated)
ALLOWED_ORIGINS=

# =============================================================================
# PLATFORM-SPECIFIC OVERRIDES
# =============================================================================

# Fly.io specific
FLY_VM_SIZE=shared-cpu-2x
FLY_VM_MEMORY=2048

# Render specific
RENDER_PLAN=starter
RENDER_DISK_SIZE=1

# Docker specific
DOCKER_BUILD_ARGS=
DOCKER_PLATFORMS=linux/amd64,linux/arm64
